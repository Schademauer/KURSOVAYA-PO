<Window x:Class="CoffeeKurs.PL.IngredientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка ингредиентов"
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F8F1E9"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4A3728" Padding="20">
            <TextBlock Text="{Binding TitleText}"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Ingredients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IngredientName}"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="#4A3728"/>
                                    <TextBlock Text="{Binding PriceText}"
                                               FontSize="13"
                                               Foreground="#8B7355"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#F8F1E9" CornerRadius="8" Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Width="30" Height="30"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                        <TextBlock Text="{Binding Count}" Width="30"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="#4A3728"/>

                                        <Button Content="+" Width="30" Height="30"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#EDE0D4" BorderThickness="0,1,0,0">
            <Button Content="Сохранить"
                    Height="45"
                    Background="#C17F59"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding SaveCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>